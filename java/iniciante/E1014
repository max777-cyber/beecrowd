package beecrowd;

import java.util.Scanner;

public class E1014 {
	public static void main(String[] args) {
		
	Scanner scanner= new Scanner(System.in);
	
	int x=scanner.nextInt();
	double y = scanner.nextDouble();
	
	
	double media= x/y;
	
	System.out.printf("%.3f km/l%n", media);

	scanner.close();
	}

}
